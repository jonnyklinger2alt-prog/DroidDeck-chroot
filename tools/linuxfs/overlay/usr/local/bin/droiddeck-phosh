#!/bin/bash
set -u

step() { echo "== phosh: $*"; }

phosh_bin() {
  local candidate
  for candidate in /usr/libexec/phosh /usr/bin/phosh; do
    [ -x "$candidate" ] && { echo "$candidate"; return 0; }
  done
  return 1
}

installed() {
  local package
  for package in "$@"; do
    [ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null)" = "install ok installed" ] || return 1
  done
}

# dbus-x11 satisfies phosh's session bus without dbus-user-session, which drags in systemd and its
# postinst cannot run in the chroot; phosh aborts without gnome-settings-daemon's schemas.
packages=(phosh phoc dbus-x11 gsettings-desktop-schemas gnome-settings-daemon-common adwaita-icon-theme)
apt=(env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confold)
if ! installed "${packages[@]}" || ! phosh_bin >/dev/null; then
  step "installing Phosh from Ubuntu (first start only, a few hundred MB)"
  status=$(dpkg-query -W -f='${Status}' systemd 2>/dev/null)
  if [ -n "$status" ] && [ "$status" != "install ok installed" ] && [ "${status#*not-installed}" = "$status" ]; then
    step "removing a half-installed systemd left by an earlier attempt"
    droiddeck-root env DEBIAN_FRONTEND=noninteractive dpkg --purge --force-depends dbus-user-session libpam-systemd systemd-sysv systemd \
      || step "could not remove the half-installed systemd"
  fi
  droiddeck-root env DEBIAN_FRONTEND=noninteractive dpkg --configure -a || step "dpkg --configure -a did not finish cleanly"
  droiddeck-root "${apt[@]}" update || { step "apt-get update failed"; exit 69; }
  droiddeck-root "${apt[@]}" install -y --no-install-recommends "${packages[@]}" \
    || { step "installing phosh and phoc failed"; exit 69; }
  installed squeekboard || droiddeck-root "${apt[@]}" install -y --no-install-recommends squeekboard \
    || step "squeekboard is not available; Android's keyboard stays the way to type"
fi
if [ ! -s /usr/share/glib-2.0/schemas/gschemas.compiled ]; then
  step "compiling GSettings schemas"
  droiddeck-root glib-compile-schemas /usr/share/glib-2.0/schemas || { step "glib-compile-schemas failed"; exit 69; }
fi
shell=$(phosh_bin) || { step "phosh is not installed"; exit 66; }

export XDG_CURRENT_DESKTOP=Phosh:GNOME XDG_SESSION_DESKTOP=phosh XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland
# The app's compositor names no DRM device (Adreno gives apps no /dev/dri), so wlroots is pointed at
# the session's render-node stand-in for the GPU; without one it can only composite in software.
node=
for candidate in /dev/dri/renderD*; do
  [ -c "$candidate" ] && [ -r "$candidate" ] && [ -w "$candidate" ] && { node=$candidate; break; }
done
if [ "${BL_PHOSH_GPU:-1}" != 0 ] && [ -n "$node" ] && [ -z "${WLR_RENDERER:-}" ]; then
  export WLR_RENDER_DRM_DEVICE=$node
else
  export WLR_RENDERER=pixman
fi
config=()
[ -f /usr/share/phosh/phoc.ini ] && config=(-C /usr/share/phosh/phoc.ini)
launch=(phoc "${config[@]}" -E "$shell")
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  launch=(dbus-run-session -- "${launch[@]}")
fi

if [ -n "${WLR_RENDER_DRM_DEVICE:-}" ]; then
  step "starting $shell in phoc on the GPU ($WLR_RENDER_DRM_DEVICE)"
  started=$(date +%s)
  "${launch[@]}"
  rc=$?
  [ "$rc" = 0 ] || [ $(( $(date +%s) - started )) -ge 15 ] && exit "$rc"
  step "phoc exited with $rc on the GPU right away; starting it again in software"
  unset WLR_RENDER_DRM_DEVICE
  export WLR_RENDERER=pixman
fi
step "starting $shell in phoc (software renderer)"
exec "${launch[@]}"
